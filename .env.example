# ============================================================
#  HALAL BSC TRADING BOT — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit your real .env file to GitHub!
#
#  Note: trading settings (strategy, bankroll %, max trades,
#  slippage, etc.) are NOT set here — they live in Redis and
#  are fully editable from the dashboard UI after you deploy.
#  The values below are only used the very first time the bot
#  runs, before you've saved anything from the dashboard.
# ============================================================

# ── WALLET (required) ─────────────────────────────────────
# Your BEP20 wallet private key, with or without the 0x prefix.
# This key signs every trade. Keep it secret. Never share it.
PRIVATE_KEY=your_64_char_hex_private_key_here

# ── NETWORK ────────────────────────────────────────────────
BSC_RPC_URL=https://bsc-dataseed1.binance.org/

# ── UPSTASH REDIS (required — free tier is plenty) ─────────
# This is what makes the dashboard's settings/tokens/positions
# persist across restarts and redeploys.
# Get yours free at: https://upstash.com → Create Database →
# copy the REST URL and REST Token (not the Redis:// URL).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── DASHBOARD / API SECURITY (required) ─────────────────────
# Any random string. This is the "dashboard key" you'll type
# into the lock-screen the first time you open the dashboard.
# Every action that touches money (buy, sell, change settings,
# add/remove tokens, start/stop) requires this.
BOT_SECRET=change_this_to_a_long_random_string

# Optional — separately protects the /api/cron/scan endpoint
# if you're calling it from an external scheduler (cron-job.org,
# GitHub Actions, etc). Leave blank to just rely on BOT_SECRET.
CRON_SECRET=

# ── TELEGRAM ALERTS (optional) ───────────────────────────────
# Leave both blank to disable. To enable: message @BotFather on
# Telegram to create a bot and get a token, then message
# @userinfobot to get your numeric chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SERVER (only used when self-hosting via server.js) ───────
PORT=3000
# How often (seconds) open positions are checked for SL/TP hits.
# This loop runs independently of the entry-scan interval, which
# is instead controlled from the dashboard (Scan interval field).
POSITION_CHECK_INTERVAL_SECONDS=60
