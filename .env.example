# ============================================================
#  HALAL BSC TRADING BOT — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit your real .env to GitHub!
# ============================================================

# Your BEP20 wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# BSC RPC endpoint (free public node)
BSC_RPC_URL=https://bsc-dataseed1.binance.org/

# BscScan API key (free at bscscan.com/apis)
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Telegram alerts (optional — leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
