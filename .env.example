# ============================================================
#  BSC SPOT TRADING BOT — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit your real .env file to GitHub!
#
#  Multi-profile note: this bot supports multiple people, each
#  with their own wallet, strategy, tokens, and history. Nobody's
#  wallet private key goes in this file — each person enters
#  their own from the dashboard after signing in with their
#  personal API key (created on first visit). The values below
#  are server-wide config only.
# ============================================================

# ── ENCRYPTION (required) ────────────────────────────────────
# 64-character hex string (32 bytes) used to encrypt every
# connected wallet's private key before it's stored. This is
# what lets the bot keep trading while people are offline — keep
# it as secret as the private keys themselves.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── NETWORK ────────────────────────────────────────────────
# HTTPS RPC: balances, contract calls, quotes, and signed transactions.
BSC_RPC_URL=https://bsc-dataseed1.binance.org/

# WebSocket RPC: live new-block feed for SL/TP monitoring. When blank,
# `npm start` uses PublicNode's public BSC WSS endpoint for easy local testing.
# For real-money production, create your own BSC WebSocket endpoint with
# a provider such as Chainstack / QuickNode / Ankr / NodeReal and paste it:
BSC_WSS_URL=

# Set false only to disable WebSocket monitoring (HTTP watchdog stays on).
LIVE_MONITOR_ENABLED=true
# A socket with no new block for this long is destroyed and reconnected.
LIVE_STALE_SECONDS=20
# Harmless live price snapshots are written to Redis at most this often;
# SL/TP evaluation itself still happens on every block.
LIVE_PRICE_PERSIST_SECONDS=3

# ── UPSTASH REDIS (required — free tier is plenty) ─────────
# This is what makes every profile's settings/tokens/positions/
# wallet persist across restarts and redeploys.
# Get yours free at: https://upstash.com → Create Database →
# copy the REST URL and REST Token (not the Redis:// URL).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── GLOBAL CRON (optional) ───────────────────────────────────
# Separately protects the /api/cron/scan endpoint, which scans
# EVERY profile in one call — only needed if you're calling it
# from an external scheduler (cron-job.org, Vercel Cron, GitHub
# Actions) instead of running server.js's built-in loop. Leave
# blank if you're self-hosting with `npm start`.
CRON_SECRET=

# ── TELEGRAM ALERTS (optional) ───────────────────────────────
# Currently server-wide (all profiles' alerts go to one chat).
# Leave both blank to disable. To enable: message @BotFather on
# Telegram to create a bot and get a token, then message
# @userinfobot to get your numeric chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SERVER (only used when self-hosting via server.js) ───────
PORT=3000
# Lightweight scheduler cadence: checks whether each profile's own entry
# scan interval is due. This does NOT control position monitoring.
ENTRY_LOOP_INTERVAL_SECONDS=3
# Emergency HTTP position check that remains active behind the live WSS
# feed. If WSS is unavailable, this still protects every open position.
POSITION_WATCHDOG_INTERVAL_SECONDS=15
